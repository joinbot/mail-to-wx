{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mail-to-wx",
	"main": "src/index.js",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	/**
	* Bind Workers AI (open-weight models, e.g. Llama)
	*/
	"ai": {
		"binding": "AI"
	},

	/**
	* Plain-text vars — replace with the real mailbox that receives forwarded mail
	*/
	"vars": {
		"FORWARD_TO_EMAIL": "your_email@example.com"
	}
}
